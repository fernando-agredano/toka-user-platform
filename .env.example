NODE_ENV=development
LOG_LEVEL=info
POSTGRES_USER=toka
POSTGRES_PASSWORD=toka_dev_pwd
MONGO_URI=mongodb://mongo:27017
REDIS_URL=redis://redis:6379
RABBITMQ_URL=amqp://toka:toka_dev_pwd@rabbitmq:5672
QDRANT_URL=http://qdrant:6333
AUTH_JWKS_URL=http://auth-service:3001/api/auth/.well-known/jwks.json
JWT_ISSUER=toka-auth
JWT_AUDIENCE=toka-api
INTERNAL_API_KEY=change_me_internal
LLM_PROVIDER=gemini            # gemini | ollama | mock
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
LLM_RPM_LIMIT=8
LLM_FALLBACK_PROVIDER=none     # ollama | mock | none: used when the primary provider is unavailable
AI_RATE_LIMIT_PER_MINUTE=5     # questions per user per minute
RAG_MIN_SCORE=0.35             # minimum cosine similarity for a chunk to reach the prompt (calibrated with eval:retrieval)
EMBEDDING_MODEL=Xenova/paraphrase-multilingual-MiniLM-L12-v2   # 384 dims; the spec's all-MiniLM-L6-v2 ranks Spanish worse
EMBEDDING_DTYPE=q8             # q8 (~118MB) | fp32 (~470MB)
LLM_PRICING_JSON=              # optional override of config/llm-pricing.json (same format)
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=llama3.2:3b
SEED_ADMIN_EMAIL=admin@toka.local
SEED_ADMIN_PASSWORD=Admin123!
MCP_RATE_LIMIT_PER_MINUTE=30   # mcp-server: tool calls per user per minute
MCP_ALLOWED_ORIGINS=http://localhost:8080   # mcp-server: browser origins allowed to call /mcp (clients without Origin are unaffected)
