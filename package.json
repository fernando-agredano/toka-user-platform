{
  "name": "toka-user-platform",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm test --workspaces --if-present",
    "test:all": "CI=true npm test --workspaces --if-present -- --verbose --coverage --coverageReporters text html json-summary && (cd frontend && CI=true npm test -- --verbose --reporters=default --coverage --coverageReporters text html json-summary) && node scripts/coverage-summary.mjs && npm run -s coverage:style",
    "docs:pdf": "node scripts/build-docs-pdf/index.mjs",
    "review:audit": "node scripts/review/audit.mjs",
    "review:mcp": "node scripts/review/mcp-connect.mjs",
    "review:logs": "docker compose logs --tail 50",
    "coverage:style": "node scripts/style-coverage.mjs",
    "review:seed": "node scripts/review/seed-demo-users.mjs"
  },
  "devDependencies": {
    "@fontsource/inter": "^5.3.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "@types/amqplib": "^0.10.6",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.2",
    "@types/opossum": "^8.1.8",
    "highlight.js": "^11.12.0",
    "jest": "^29.7.0",
    "marked": "^18.1.0",
    "mermaid": "^11.17.2",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^5.6.205",
    "playwright": "^1.64.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2"
  }
}
